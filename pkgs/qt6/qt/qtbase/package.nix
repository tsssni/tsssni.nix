    "metatypes"
    "mkspecs"
    "modules"
    "lib/qt-6/plugins/{egldeviceintegrations,generic,networkinformation,platforminputcontexts,printsupport,sqldrivers,tls,wayland-decoration-client,xcbglintegrations}"
